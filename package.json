{
  "name": "gulbargahomes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-property-seed.mjs && node scripts/build-content-seed.mjs && next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/pagefind || true",
    "images": "node scripts/generate-property-media.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "node --no-warnings --experimental-test-module-mocks --import tsx --test \"tests/**/*.test.ts\"",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "deploy:staging": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env staging -- --keep-vars",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload -- --keep-vars",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:seed": "node scripts/build-property-seed.mjs",
    "erasure:sql": "tsx scripts/erasure-sql.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "gray-matter": "^4.0.3",
    "next": "^15.5.28",
    "pagefind": "^1.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.4.47",
    "sharp": "^0.35.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.155.0"
  }
}
