# Copy to .env.local for local development

# Secret token for POST /api/revalidate (set the same in Netlify env vars)
REVALIDATE_SECRET=your-secret-here

# Optional: Netlify build hook URL to trigger a full rebuild after CMS edits
NETLIFY_BUILD_HOOK_URL=

# GA4 measurement ID. The site uses G-47GFXYGBTL when this is unset.
NEXT_PUBLIC_GA4_ID=G-47GFXYGBTL
NEXT_PUBLIC_CLARITY_ID=
