# Copy to .env.local for local development. Do not commit secrets.

# Listing desk at /admin/properties
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=random-32-chars-openssl-rand-hex-32
# Set to "disabled" once every staff member has a named account (Team page)
ADMIN_LEGACY_LOGIN=

# Optional token for POST /api/revalidate
REVALIDATE_SECRET=your-secret-here

# GA4 measurement ID. The site uses G-47GFXYGBTL when this is unset.
NEXT_PUBLIC_GA4_ID=G-47GFXYGBTL
NEXT_PUBLIC_CLARITY_ID=

# Cloudflare Worker preview reads .dev.vars (see .dev.vars.example).
# Do not put ADMIN_PASSWORD in wrangler.jsonc. Set it as a Worker secret.
