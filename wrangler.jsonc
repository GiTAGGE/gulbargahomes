{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gulbargahomes",
  // worker.ts wraps .open-next/worker.js and adds the Meta Lead Ads cron sweep.
  "main": "worker.ts",
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // workers.dev stays as a rollback URL. Production traffic uses Custom Domains.
  "workers_dev": true,
  "routes": [
    { "pattern": "gulbargahomes.com", "custom_domain": true },
    { "pattern": "www.gulbargahomes.com", "custom_domain": true }
  ],
  "upload_source_maps": true,
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    // Webhook handshakes and the OAuth callback carry hub.verify_token / code in the query string.
    "redact_query_string": true
  },
  // Variables added in the dashboard survive deploys that do not pass --keep-vars (e.g. Workers Builds).
  // Secrets are never stored here and are always kept.
  "keep_vars": true,
  "images": {
    // Requires Cloudflare Images on the account. If optimization fails,
    // remove this block and set images.unoptimized: true in next.config.mjs.
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "gulbargahomes"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "gulbargahomes-next-cache"
    },
    {
      "binding": "MEDIA",
      "bucket_name": "gulbargahomes-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gulbargahomes",
      "database_id": "a820c890-b410-4b19-929d-bcd9a1a52408",
      "migrations_dir": "migrations"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "gulbargahomes-next-tag-cache",
      "database_id": "5b9f52e0-7e3f-4f11-a936-77506aa41ab2"
    }
  ],
  // Staging Worker on workers.dev with its own D1 and R2 (docs/meta-lead-ads.md, "Staging").
  // Create the resources and replace the REPLACE_ ids before `--env staging` deploys.
  "env": {
    "staging": {
      "name": "gulbargahomes-staging",
      // Must stay empty: routes are inherited, and staging must never claim the production domains.
      "routes": [],
      "workers_dev": true,
      "images": { "binding": "IMAGES" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "gulbargahomes-staging" }],
      "r2_buckets": [
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "gulbargahomes-staging-next-cache" },
        { "binding": "MEDIA", "bucket_name": "gulbargahomes-staging-media" }
      ],
      "durable_objects": {
        "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "gulbargahomes-staging",
          "database_id": "REPLACE_WITH_STAGING_DB_ID",
          "migrations_dir": "migrations"
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "gulbargahomes-staging-next-tag-cache",
          "database_id": "REPLACE_WITH_STAGING_TAG_CACHE_ID"
        }
      ]
    }
  }
}
